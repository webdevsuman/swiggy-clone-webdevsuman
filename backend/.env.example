PORT=5000

# MongoDB Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/swiggy-clone

# Admin Secret Key for Two-Factor Admin Authorization (Scope.md requirement)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Initial Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=Superadmin@12345

# Nodemailer Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@gmail.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Configuration
JWT_SECRET=your_jwt_access_secret_hash_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_hash_here

# Frontend URLs
FRONTEND_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
